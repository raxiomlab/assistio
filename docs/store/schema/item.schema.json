{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistio.dev/store/schema/item.schema.json",
  "title": "AssistIO Store item manifest",
  "description": "Public definition of one installable resource. One manifest per folder; the catalog is generated from these files.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "slug",
    "version",
    "publisher",
    "license",
    "locales",
    "tags",
    "platforms",
    "requires",
    "permissions",
    "entry",
    "changelog"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "Globally unique. Convention: <publisher>.<kind>.<slug>"
    },
    "kind": { "enum": ["skill", "extension", "app", "forge"] },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "channel": { "enum": ["stable", "beta", "nightly"], "default": "stable" },
    "publisher": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri" },
        "verified": { "type": "boolean", "default": false }
      }
    },
    "license": { "type": "string", "minLength": 2, "maxLength": 80 },
    "homepage": { "type": "string", "format": "uri" },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "featured": { "type": "boolean", "default": false },
    "icon": {
      "type": "string",
      "description": "Icon key from the store sprite (sparkles, code, git, receipt, users, rss, table, ...)."
    },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "propertyNames": { "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
      "additionalProperties": { "$ref": "#/$defs/locale" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["desktop", "web", "android"] }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assistio": { "type": "string", "minLength": 1 },
        "network": { "type": "boolean", "default": false },
        "runtime": { "enum": ["declarative", "browser", "node"], "default": "declarative" },
        "tools": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
              "label": { "$ref": "#/$defs/l10n" },
              "kind": { "enum": ["api-key", "oauth", "token", "path", "url"] },
              "required": { "type": "boolean", "default": true },
              "secretRef": {
                "type": "string",
                "description": "Vault reference only. Secrets are never published in a manifest."
              },
              "help": { "$ref": "#/$defs/l10n" }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "risk", "label", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "fs.read",
              "fs.write",
              "net.read",
              "shell.run",
              "git.read",
              "app.storage",
              "downloads.write",
              "clipboard.write",
              "secrets.read",
              "kanban.write",
              "ui.commands",
              "ui.theme",
              "agents.install",
              "prompts.install",
              "settings.write"
            ]
          },
          "risk": { "enum": ["low", "medium", "high"] },
          "label": { "$ref": "#/$defs/l10n" },
          "reason": { "$ref": "#/$defs/l10n" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["skill", "extension", "app", "forge"] },
        "path": {
          "type": "string",
          "description": "Relative file for skill or app entries. Required for skill and app."
        },
        "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "sandbox": { "enum": ["strict", "local"], "default": "strict" }
      }
    },
    "contributes": {
      "type": "object",
      "description": "Extension contribution points. Validated by the AssistIO extension engine.",
      "additionalProperties": true,
      "properties": {
        "commands": { "type": "array", "items": { "type": "object" } },
        "agents": { "type": "array", "items": { "type": "object" } },
        "prompts": { "type": "array", "items": { "type": "object" } },
        "settings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "definition": {
      "type": "object",
      "description": "Forge capability definition. Declarative steps only — no executable code.",
      "additionalProperties": true,
      "properties": {
        "tool": { "type": "object" },
        "steps": { "type": "array", "items": { "type": "object" } },
        "output": {},
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "date"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "breaking": { "type": "boolean", "default": false },
          "notes": { "$ref": "#/$defs/l10n" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["skill", "app"] } } },
      "then": {
        "properties": { "entry": { "required": ["path"] } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "extension" } } },
      "then": { "required": ["contributes"] }
    },
    {
      "if": { "properties": { "kind": { "const": "forge" } } },
      "then": { "required": ["definition"] }
    }
  ],
  "$defs": {
    "l10n": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": { "type": "string" },
      "properties": { "en": { "type": "string" } }
    },
    "locale": {
      "type": "object",
      "required": ["name", "summary", "readme"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 220 },
        "readme": { "type": "string", "minLength": 10, "maxLength": 12000 }
      }
    }
  }
}
