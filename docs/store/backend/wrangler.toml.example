# Copy to wrangler.toml, fill the ids, then deploy from docs/store/backend.
name = "assistio-store-api"
main = "worker.js"
compatibility_date = "2026-01-01"

# Origins allowed to POST events and submissions. Read requests are public.
# Use the exact site origin (scheme + host + port), no trailing slash.
[vars]
ALLOWED_ORIGINS = "https://your-store.example.com,http://localhost:8000,http://localhost:8123"

[[d1_databases]]
binding = "DB"
database_name = "assistio-store"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Secrets (never commit them):
#   wrangler secret put ADMIN_TOKEN
#   wrangler secret put IP_SALT

# Optional: prune private counters daily.
[triggers]
crons = ["17 4 * * *"]
